# Frontend (React) environment variables
# Copy to .env and fill in actual values. Never commit .env.

# --- Backend API ---
VITE_BACKEND_API_URL=http://localhost:8000

# --- MapLibre ---
# If using a tile provider that requires a key, set it here.
# For demo, OpenStreetMap tiles require no key.
VITE_MAPTILER_KEY=

# --- H3 ---
VITE_H3_RESOLUTION=8
