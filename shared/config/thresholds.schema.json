{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GeoProtect Thresholds Configuration",
  "type": "object",
  "required": ["h3_resolution", "tiers", "imd_rainfall_classes", "demo_gauge"],
  "properties": {
    "h3_resolution": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15,
      "description": "H3 hex resolution used for village-scale matching."
    },
    "tiers": {
      "type": "object",
      "patternProperties": {
        "^tier_[0-9]+$": {
          "type": "object",
          "required": ["label", "payout_percent", "triggers"],
          "properties": {
            "label": { "type": "string" },
            "payout_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "triggers": {
              "type": "object",
              "required": ["rainfall_mm_min", "gauge_above", "inundation_pct_min"],
              "properties": {
                "rainfall_mm_min": { "type": "number", "minimum": 0 },
                "gauge_above": {
                  "type": "string",
                  "enum": ["warning_level", "danger_level", "highest_flood_level"]
                },
                "inundation_pct_min": { "type": "number", "minimum": 0, "maximum": 100 }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "imd_rainfall_classes": {
      "type": "object",
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    },
    "demo_gauge": {
      "type": "object",
      "required": ["station_name", "river", "state", "warning_level_m", "danger_level_m", "highest_flood_level_m"],
      "properties": {
        "station_name": { "type": "string" },
        "river": { "type": "string" },
        "state": { "type": "string" },
        "warning_level_m": { "type": "number" },
        "danger_level_m": { "type": "number" },
        "highest_flood_level_m": { "type": "number" }
      }
    }
  }
}
