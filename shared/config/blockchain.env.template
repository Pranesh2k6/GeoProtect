# Blockchain Gateway (Go) environment variables
# Copy to .env and fill in actual values. Never commit .env.

# --- Server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8200

# --- Drunix / Fabric connection ---
DRUNIX_PEER_ENDPOINT=localhost:7051
DRUNIX_ORDERER_ENDPOINT=localhost:7050
DRUNIX_CHANNEL_NAME=geoprotect-channel
DRUNIX_CHAINCODE_NAME=geoprotect-cc
DRUNIX_MSP_ID=Org1MSP

# --- TLS (paths to certs) ---
DRUNIX_TLS_CERT_PATH=
DRUNIX_TLS_KEY_PATH=
DRUNIX_TLS_CA_CERT_PATH=

# --- YugabyteDB ---
YUGABYTE_HOST=localhost
YUGABYTE_PORT=5433
YUGABYTE_DB=drunix_state
YUGABYTE_USER=yugabyte
YUGABYTE_PASSWORD=changeme

# --- Logging ---
LOG_LEVEL=INFO
